from __future__ import annotations

import re
from typing import Any


# ---------------------------------------------------------------------
# Production relevance policy
# ---------------------------------------------------------------------

# These are entities that may be detected by the registry but should not,
# by themselves, prevent a low-signal market/general story being filtered.
NON_PRUDENTIAL_ENTITY_NAMES = {
    "Colombo Stock Exchange",
}


def _safe_float(value: Any) -> float | None:
    try:
        if value is None or value == "":
            return None
        return float(value)
    except (TypeError, ValueError):
        return None


def _entity_names(ml_payload: dict) -> set[str]:
    names: set[str] = set()

    for item in (
        ml_payload.get("cbsl_entity_matches", [])
        or []
    ):
        if not isinstance(item, dict):
            continue

        name = str(
            item.get("canonical_name", "")
            or ""
        ).strip()

        if name:
            names.add(name)

    return names


def apply_relevance_policy(
    *,
    stage1: dict,
    ml_payload: dict,
    supervisory_comparison: dict,
) -> dict:
    """
    Apply a conservative production policy on top of the raw Stage-A model.

    IMPORTANT:
    - Raw model output is preserved.
    - Stage B remains auxiliary.
    - Only obvious high-confidence production errors are overridden.
    """

    relevance = (
        ml_payload.get("supervisory_relevance", {})
        or {}
    )

    stage_a = (
        relevance.get("stage_a", {})
        or {}
    )

    stage_b = (
        relevance.get("stage_b", {})
        or {}
    )

    raw_label = str(
        stage_a.get("predicted_label", "")
        or ""
    ).strip().upper()

    raw_confidence = _safe_float(
        stage_a.get("confidence")
    )

    stage1_decision = str(
        stage1.get("gate_decision", "")
        or ""
    ).strip().upper()

    financial_score = _safe_float(
        stage1.get("financial_relevance_score")
    )

    pr_score = _safe_float(
        stage1.get("pr_noise_score")
    )

    entity_names = _entity_names(
        ml_payload
    )

    has_cbsl = (
        "Central Bank of Sri Lanka"
        in entity_names
    )

    strong_entity_names = {
        name
        for name in entity_names
        if name not in NON_PRUDENTIAL_ENTITY_NAMES
    }

    has_strong_financial_entity = bool(
        strong_entity_names
    )

    stage_b_executed = bool(
        relevance.get("stage_b_executed")
    )

    stage_b_label = str(
        stage_b.get("predicted_label", "")
        or ""
    ).strip().upper()

    stage_b_confidence = _safe_float(
        stage_b.get("confidence")
    )

    operational_label = raw_label
    override_reason = None

    # -------------------------------------------------------------
    # GUARD 1:
    # Do not silently lose a strong Stage-1 supervisory article.
    #
    # Example:
    # CBSL Governor + HIGH financial score + low PR signal.
    # -------------------------------------------------------------
    if (
        raw_label == "NOISE"
        and stage1_decision == "INCLUDE_CANDIDATE"
        and financial_score is not None
        and financial_score >= 70
        and pr_score is not None
        and pr_score < 40
        and (
            has_cbsl
            or has_strong_financial_entity
        )
    ):
        operational_label = "KEEP"
        override_reason = (
            "STAGE1_HIGH_SUPERVISORY_SAFETY_OVERRIDE"
        )

    # -------------------------------------------------------------
    # GUARD 2:
    # Suppress obvious low-signal Stage-A false positives.
    #
    # Examples from live QA:
    # - routine CSE daily movement
    # - Port City real-estate tax story
    #
    # We do NOT suppress when a meaningful regulated entity is present.
    # We also leave genuinely strong Stage-B evidence alone.
    # -------------------------------------------------------------
    elif (
        raw_label == "KEEP"
        and stage1_decision == "EXCLUDE_NOISE"
        and financial_score is not None
        and financial_score < 30
        and not has_strong_financial_entity
    ):
        stage_b_strong_relevant = (
            stage_b_executed
            and stage_b_label == "RELEVANT"
            and stage_b_confidence is not None
            and stage_b_confidence >= 0.70
        )

        if not stage_b_strong_relevant:
            operational_label = "NOISE"
            override_reason = (
                "STAGE1_LOW_SIGNAL_FALSE_POSITIVE_GUARD"
            )

    operational_decision = (
        "KEEP"
        if operational_label == "KEEP"
        else "FILTER_NOISE"
    )

    # Preserve raw model result explicitly.
    stage_a["raw_predicted_label"] = raw_label
    stage_a["raw_confidence"] = raw_confidence

    # Production result used downstream.
    stage_a["operational_label"] = operational_label
    stage_a["operational_decision"] = operational_decision
    stage_a["operational_override_applied"] = bool(
        override_reason
    )
    stage_a["operational_override_reason"] = (
        override_reason
    )

    relevance["stage_a"] = stage_a
    ml_payload["supervisory_relevance"] = relevance

    policy_payload = {
        "raw_stage_a_label": raw_label,
        "raw_stage_a_confidence": raw_confidence,
        "operational_label": operational_label,
        "operational_decision": operational_decision,
        "override_applied": bool(override_reason),
        "override_reason": override_reason,
        "stage1_decision": stage1_decision,
        "financial_score": financial_score,
        "pr_score": pr_score,
        "entities": sorted(entity_names),
    }

    supervisory_comparison[
        "production_policy"
    ] = policy_payload

    # Any override remains visible for analyst review.
    if override_reason:
        supervisory_comparison[
            "overall_review_priority"
        ] = "HIGH"

    return {
        "ml_payload": ml_payload,
        "supervisory_comparison": supervisory_comparison,
        "production_policy": policy_payload,
    }


def operational_stage_a_label(
    analysis: dict,
) -> str:
    """
    Get the production Stage-A label.

    Falls back to raw prediction for older outputs.
    """

    relevance = (
        (
            analysis.get("ml", {})
            or {}
        ).get(
            "supervisory_relevance",
            {},
        )
        or {}
    )

    stage_a = (
        relevance.get("stage_a", {})
        or {}
    )

    return str(
        stage_a.get("operational_label")
        or stage_a.get("predicted_label")
        or ""
    ).strip().upper()


# ---------------------------------------------------------------------
# Taxonomy evidence policy
# ---------------------------------------------------------------------

TOPIC_EVIDENCE_PATTERNS = {
    "AML_CFT_SANCTIONS": re.compile(
        r"\b("
        r"anti[- ]money laundering|"
        r"money laundering|"
        r"aml|"
        r"terrorist financing|"
        r"counter[- ]terrorist financing|"
        r"cft|"
        r"sanction(?:s|ed)?|"
        r"financial intelligence unit|"
        r"fiu|"
        r"fatf|"
        r"kyc|"
        r"know your customer|"
        r"suspicious transaction|"
        r"proliferation financing"
        r")\b",
        flags=re.IGNORECASE,
    ),

    "ASSET_QUALITY_NPL_STAGE3": re.compile(
        r"\b("
        r"non[- ]performing(?: loan| loans)?|"
        r"npl|"
        r"stage\s*3|"
        r"impaired|"
        r"impairment|"
        r"provision(?:s|ing)?|"
        r"expected credit loss|"
        r"ecl|"
        r"arrears|"
        r"delinquen\w*|"
        r"asset quality|"
        r"bad loan(?:s)?"
        r")\b",
        flags=re.IGNORECASE,
    ),
}


def evidence_gate_topics(
    *,
    primary_topic: str,
    topic_labels: list[str],
    article_text: str,
) -> tuple[str, list[str], list[dict]]:
    """
    Remove narrow high-specificity topics when the article does not
    contain direct textual evidence.

    Broad topics such as MACRO_FINANCIAL_SYSTEMIC are untouched.
    """

    text = str(
        article_text
        or ""
    )

    original_primary = str(
        primary_topic
        or ""
    ).strip().upper()

    cleaned_labels: list[str] = []
    suppressions: list[dict] = []

    seen: set[str] = set()

    for raw_topic in (
        topic_labels
        or []
    ):
        topic = str(
            raw_topic
            or ""
        ).strip().upper()

        if not topic or topic in seen:
            continue

        seen.add(topic)

        pattern = (
            TOPIC_EVIDENCE_PATTERNS.get(
                topic
            )
        )

        if (
            pattern is not None
            and pattern.search(text) is None
        ):
            suppressions.append(
                {
                    "topic": topic,
                    "reason": (
                        "NO_DIRECT_SOURCE_TEXT_EVIDENCE"
                    ),
                }
            )
            continue

        cleaned_labels.append(
            topic
        )

    if not cleaned_labels:
        cleaned_labels = [
            "OTHER_SUPERVISORY"
        ]

    if (
        original_primary
        in cleaned_labels
    ):
        cleaned_primary = (
            original_primary
        )
    else:
        cleaned_primary = (
            cleaned_labels[0]
        )

    return (
        cleaned_primary,
        cleaned_labels,
        suppressions,
    )