    text-align: left;
    text-transform: uppercase;
}}
.other-table th:nth-child(1) {{ width: 26%; }}
.other-table th:nth-child(2) {{ width: 22%; }}
.other-table th:nth-child(3) {{ width: 52%; }}
.other-table td {{
    padding: 11px;
    border-bottom: 1px solid #e7ecef;
    vertical-align: top;
    color: #31424d;
    font-size: 14px;
}}
.other-table tr:last-child td {{
    border-bottom: 0;
}}
.other-title a {{
    display: block;
    margin-top: 2px;
    color: #173e59;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
}}
.small-muted {{
    margin-top: 2px;
    color: #7a8993;
    font-size: 12px;
}}
.event-group {{
    margin-bottom: 10px;
    padding: 13px 15px;
    border: 1px solid #dfe5ea;
    background: #f8fafb;
}}
.event-label {{
    color: #8b6a2f;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}}
.event-group h3 {{
    margin: 2px 0 7px;
    color: #173a56;
}}
.event-group ul {{
    margin: 0;
    padding-left: 18px;
}}
.event-group li {{
    margin: 3px 0;
}}
.event-group li span {{
    margin-left: 5px;
    color: #74828b;
    font-size: 12px;
}}
.empty-state {{
    padding: 16px;
    border: 1px solid #dfe5ea;
    background: #f8fafb;
    color: #72828d;
}}
.report-footer {{
    padding: 17px 38px 23px;
    border-top: 1px solid #dce3e9;
    background: #f8fafb;
    color: #697b87;
    font-size: 12px;
}}
.report-footer strong {{
    color: #405663;
}}

@media (max-width: 760px) {{
    .report-shell {{
        margin: 0;
        border-left: 0;
        border-right: 0;
    }}
    .report-header,
    .report-content,
    .report-footer {{
        padding-left: 20px;
        padding-right: 20px;
    }}

    .header-row,
    .header-title,
    .header-date,
    .priority-card,
    .priority-number,
    .priority-body,
    .meta-row,
    .meta-main,
    .meta-topics,
    .context-card-head,
    .context-card-head > div,
    .context-card-head > .source-link,
    .story-footer,
    .context-wrap,
    .story-footer > .source-link {{
        display: block;
        width: 100%;
    }}
    .header-date,
    .meta-topics,
    .context-card-head > .source-link,
    .story-footer > .source-link {{
        margin-top: 8px;
        text-align: left;
    }}
    .priority-number {{
        padding: 7px 12px;
        text-align: left;
    }}


    .other-table,
    .other-table thead,
    .other-table tbody,
    .other-table tr,
    .other-table th,
    .other-table td {{
        display: block;
        width: 100% !important;
    }}
    .other-table thead {{
        display: none;
    }}
    .other-table td {{
        border-bottom: 0;
        padding-top: 4px;
        padding-bottom: 4px;
    }}
    .other-table tr {{
        padding: 9px 4px;
        border-bottom: 1px solid #e7ecef;
    }}
}}
@media print {{
    @page {{
        size: A4;
        margin: 12mm;
    }}
    html,
    body {{
        background: #ffffff;
    }}
    .report-shell {{
        max-width: none;
        margin: 0;
        border: 0;
        box-shadow: none;
    }}
    .source-link {{
        color: #0c557c;
    }}
    .priority-card,
    .context-card,
    .event-group,
    .other-table tr {{
        page-break-inside: avoid;
    }}
}}
</style>
</head>
<body>
<div class="report-shell">
    <div class="top-rule"></div>

    <header class="report-header">
        <div class="header-kicker">FINANCIAL SECTOR</div>
        <div class="header-row">
            <div class="header-title">
                <h1>{escape(title)}</h1>
                <p>The latest banking, financial sector and market news.</p>
            </div>
            <div class="header-date">
                <div class="date-label">Reporting period</div>
                <div class="date-value">{escape(period_label)}</div>
            </div>
        </div>
    </header>


    <main class="report-content">
        <section class="report-section">
            <div class="section-title-row">
                <div>
                    <div class="section-kicker">NEWS HIGHLIGHTS</div>
                    <h2>Key developments</h2>
                    <p>Key updates affecting financial institutions and the wider sector.</p>
                </div>
            </div>
            {priority_html}
        </section>

        <section class="report-section">
            <div class="section-title-row">
                <div>
                    <div class="section-kicker">ECONOMY &amp; MARKETS</div>
                    <h2>Economy &amp; markets</h2>
                    <p>Updates on the economy, interest rates, currencies and financial markets.</p>
                </div>
            </div>
            {macro_html}
        </section>

        {other_html}

        {event_section()}
    </main>

    <footer class="report-footer">
        <strong>About this report:</strong>
        Summaries are based on the original news articles. Commentary highlights possible implications for the financial sector.
        Original-source links are provided for verification.
    </footer>
</div>
</body>
</html>
"""


def render_email_html(
    *,
    title: str,
    period_label: str,
    priority_articles: list[DigestArticle],
    macro_market_articles: list[DigestArticle],
    other_articles: list[DigestArticle],
) -> str:
    """Render a stakeholder brief with table layout and inline email styles."""
    sections = []
    for heading, articles in (
        ("Key developments", priority_articles),
        ("Economy & markets", macro_market_articles),
        ("Other news", other_articles),
    ):
        rows = []
        for article in articles:
            scope = "; ".join(article.primary_entities) or "Across the financial sector"
            institution_types = "; ".join(value for value in article.primary_entity_types if value)
            rows.append(f"""
<tr><td style="padding:16px 0;border-bottom:1px solid #dce3ea;">
  <p style="margin:0;color:#526477;">{escape(article.source_name)} | {escape(article.publication_date)}</p>
  <h3 style="margin:8px 0;">{escape(article.headline)}</h3>
  <p><strong>Who it affects:</strong> {escape(scope)}</p>
  <p>{escape(institution_types)}</p>
  <p><strong>Topics:</strong> {escape('; '.join(article.topic_display_names))}</p>
  <p><strong>What happened:</strong> {escape(article.news_summary)}</p>
  <p><strong>Why it matters:</strong> {escape(article.supervisory_lens)}</p>
  <a style="color:#175a85;" href="{escape(article.source_url, quote=True)}">View original source</a>
</td></tr>""")
        body = "".join(rows) or '<tr><td style="padding:16px 0;">No developments in this section.</td></tr>'
        sections.append(
            f'<tr><td style="padding-top:24px;"><h2>{escape(heading)}</h2>'
            f'<table role="presentation" width="100%" cellpadding="0" cellspacing="0">{body}</table></td></tr>'
        )
    return f"""<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>{escape(title)} | Email Edition</title><meta name="viewport" content="width=device-width, initial-scale=1"></head>
<body style="margin:0;background:#f3f6f9;color:#183047;font-family:Arial,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center">
<table role="presentation" width="680" cellpadding="24" cellspacing="0" style="width:100%;max-width:680px;background:#ffffff;">
<tr><td style="border-top:6px solid #0b3154;"><p style="font-size:12px;letter-spacing:1px;color:#526477;">FINANCIAL SECTOR &middot; EMAIL EDITION</p><h1 style="color:#0b3154;">{escape(title)}</h1><p>{escape(period_label)}</p><p>Banking, economy and market developments, with the context that matters.</p></td></tr>
{''.join(sections)}
<tr><td style="font-size:12px;color:#526477;">Summaries are based on the original news articles.
Commentary highlights possible implications for the financial sector.
Original-source links are provided for verification.</td></tr>
</table></td></tr></table></body></html>"""


def render_qa_html(
    *,
    title: str,
    period_label: str,
    generated_at: str,
    review_rows: list[dict],
    metrics: dict,
    config: dict,
) -> str:
    """Render an analyst review desk with plain-language reasons and optional details."""
    reason_labels = {
        "Stage-1 / Stage-A disagreement": "The initial screening and relevance check disagree.",
        "Stage-B auxiliary RELEVANT": "The article may warrant closer attention.",
        "HDBSCAN semantic outlier": "The story differs from the other coverage in this period.",
        "Phase-2 HIGH review priority": "The review process marked this article for priority attention.",
    }
    label_names = {
        "KEEP": "Selected for monitoring",
        "NOISE": "Filtered from the news selection",
        "RELEVANT": "Closer attention suggested",
        "WATCH": "Monitor",
        "NOT_EXECUTED": "Not assessed",
    }
    cards = []
    for row in review_rows:
        reasons = row.get("reasons", []) or []
        if isinstance(reasons, str):
            reasons = [reasons]
        reason_items = "".join(
            f'<li>{escape(reason_labels.get(safe_text(reason), safe_text(reason)))}</li>'
            for reason in reasons
        )
        priority = safe_text(row.get("phase2_review_priority")).upper()
        priority_text = "Priority review" if priority == "HIGH" else "Review suggested"
        screening = safe_text(row.get("stage_a_label"))
        attention = safe_text(row.get("stage_b_label"))
        cards.append(f"""
<article class="review-card">
<div class="card-top"><span>{escape(safe_text(row.get('source_name')))}</span><span class="badge {'urgent' if priority == 'HIGH' else ''}">{priority_text}</span></div>
<h3>{escape(safe_text(row.get('headline')))}</h3>
<div class="reasons"><strong>Why review this story</strong><ul>{reason_items or '<li>Check the article before confirming its relevance.</li>'}</ul></div>
<a class="source-button" href="{escape(safe_text(row.get('source_url')), quote=True)}" target="_blank" rel="noopener noreferrer">Read original article &rarr;</a>
<details><summary>Review details</summary>
<dl><dt>Screening result</dt><dd>{escape(label_names.get(screening, screening))} <small>({escape(screening)})</small></dd>
<dt>Attention signal</dt><dd>{escape(label_names.get(attention, attention))} <small>({escape(attention)})</small></dd></dl>
</details></article>""")
    body = "".join(cards) or '<div class="empty-state"><h3>Nothing to review</h3><p>No stories were flagged for review in this period.</p></div>'
    total_flags = int(metrics.get('review_flag_count', len(review_rows)) or 0)
    coverage_note = (
        '<p class="coverage-note">This page shows a selection of the stories awaiting review. '
        'Increase the review display limit to include the remaining stories.</p>'
        if total_flags > len(review_rows) else ""
    )
    return f"""<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Review Desk | {escape(title)}</title>
<style>
* {{ box-sizing:border-box; }}
body {{ margin:0; background:#edf1f5; color:#1b2733; font:16px 'Segoe UI',Arial,sans-serif; line-height:1.6; }}
.shell {{ max-width:1080px; margin:28px auto; background:white; border:1px solid #dce3e9; box-shadow:0 12px 34px #16293a14; border-top:6px solid #0b3154; }}
a {{ color:#0d547a; }} a:focus-visible {{ outline:3px solid #b28a44; outline-offset:3px; }}
header {{ padding:30px 38px; border-bottom:1px solid #dce3e9; }}
.kicker {{ margin:0 0 8px; color:#577080; font-size:12px; letter-spacing:1px; font-weight:700; }}
h1 {{ margin:0; color:#0b3154; font-size:38px; line-height:1.2; }}
header p {{ margin:10px 0 0; color:#526477; }} .period {{ font-weight:600; }}
main {{ padding:28px 38px; }} h2 {{ color:#173a56; font-size:24px; margin:0 0 8px; }}
.intro {{ margin:0 0 24px; color:#526477; }}
.review-card {{ padding:24px; border:1px solid #dce3e9; border-radius:12px; margin-bottom:18px; }}
.card-top {{ display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; color:#526477; font-size:14px; }}
.badge {{ background:#edf3f8; color:#28556f; padding:4px 10px; border-radius:20px; font-weight:600; }}
.badge.urgent {{ background:#fbf3e4; color:#805817; }}
h3 {{ color:#173a56; margin:14px 0; font-size:21px; line-height:1.4; }}
.reasons {{ padding:16px; background:#f5f8fa; border-radius:8px; }}
ul {{ margin:8px 0 0; padding-left:22px; }} li {{ margin:4px 0; }}
.source-button {{ display:inline-block; margin-top:18px; font-weight:600; text-decoration:none; }}
details {{ margin-top:18px; padding-top:14px; border-top:1px solid #e4e9ed; color:#526477; }}
summary {{ cursor:pointer; font-weight:600; }} dl {{ display:grid; grid-template-columns:160px 1fr; gap:8px; }} dd {{ margin:0; }} small {{ font-size:12px; }}
.guide {{ padding:24px; background:#f3f7f9; border-radius:12px; margin-top:30px; }}
.guide p {{ margin:10px 0; }} .download {{ display:inline-block; padding:10px 16px; border-radius:8px; background:#0b3154; color:white; text-decoration:none; font-weight:600; }}
.empty-state {{ padding:24px; background:#f5f8fa; border-radius:12px; }}
footer {{ padding:20px 38px; border-top:1px solid #dce3e9; color:#526477; font-size:14px; }}
@media(max-width:640px) {{ .shell {{ margin:0; border-left:0; border-right:0; }} header,main,footer {{ padding:20px; }} h1 {{ font-size:30px; }} .review-card {{ padding:18px; }} dl {{ grid-template-columns:1fr; }} }}
@media print {{ body {{ background:white; }} .shell {{ margin:0; border:0; box-shadow:none; }} .download {{ display:none; }} .review-card {{ break-inside:avoid; }} }}
</style></head><body><div class="shell">
<header><p class="kicker">ARTICLE REVIEW</p><h1>Review Desk</h1>
<p>Check stories that need a second look and record your editorial decisions.</p><p class="period">{escape(period_label)}</p></header>
<main><h2>Stories to review</h2><p class="intro">Read the original article, check why it was flagged, and decide whether it belongs in the news brief.</p>
{coverage_note}{body}
<section class="guide"><h2>Record your review</h2>
<p>Use the review worksheet to record relevance, topic, your decision, reviewer name and notes.
Suggest a new topic where needed, and approve training use only after checking the story.</p>
<a class="download" href="model_learning_review.csv" download>Download review worksheet</a>
<p>Save the completed worksheet in this report folder using the same filename. Your existing notes will be carried forward when the report is rebuilt.</p></section>
</main><footer>Review suggestions are automated. Confirm relevance and topics against the original article before approving a story for future model training.</footer>
</div></body></html>"""


__all__ = [
    "DigestArticle",
    "all_entities",
    "calculate_display_priority",
    "calculate_supervisory_importance",
    "display_institution_type",
    "display_topic",
    "first_sentences",
    "has_primary_regulated_entity",
    "load_reporting_config",
    "primary_entities",
    "primary_entity_details",
    "render_html",
    "render_email_html",
    "render_qa_html",
    "safe_text",
    "source_summary",
    "supervisory_lens",
]
