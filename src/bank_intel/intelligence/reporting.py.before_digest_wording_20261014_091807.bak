from __future__ import annotations

from dataclasses import asdict, dataclass
from html import escape, unescape
from pathlib import Path
import re
from typing import Iterable

import yaml

PROJECT_ROOT = Path(__file__).resolve().parents[3]
DEFAULT_REPORTING_CONFIG = PROJECT_ROOT / "config" / "intelligence" / "reporting.yaml"


def load_reporting_config(path: Path | str = DEFAULT_REPORTING_CONFIG) -> dict:
    payload = yaml.safe_load(Path(path).read_text(encoding="utf-8-sig"))
    if not isinstance(payload, dict):
        raise RuntimeError(f"Invalid reporting configuration: {path}")
    return payload


def safe_text(value) -> str:
    text = unescape(str(value or ""))
    text = (
        text.replace("â€™", "'")
        .replace("â€“", "-")
        .replace("â€”", "-")
        .replace("\xa0", " ")
        .replace("\\r\\n", " ")
        .replace("\\n", " ")
        .replace("\\r", " ")
        .replace("\\t", " ")
    )
    return re.sub(r"\s+", " ", text).strip()


def _clean_raw_source_text(value) -> str:
    """
    Clean source extraction artefacts before sentence selection.

    The summary remains entirely source-derived.
    """
    text = unescape(str(value or ""))

    text = (
        text.replace("â€™", "'")
        .replace("â€“", "-")
        .replace("â€”", "-")
        .replace("\xa0", " ")
        .replace("\\r\\n", "\n")
        .replace("\\n", "\n")
        .replace("\\r", "\n")
        .replace("\\t", " ")
    )

    text = re.sub(r"\r\n?", "\n", text)

    # Standalone author line, e.g. "H. Senewiratne".
    text = re.sub(
        r"^\s*(?:[A-Z]\.\s*){1,4}[A-Z][A-Za-z'’\-]+"
        r"(?:\s+[A-Z][A-Za-z'’\-]+){0,3}\s*\n+",
        "",
        text,
    )

    compact = re.sub(r"\s+", " ", text).strip()

    # Publisher teaser/deck text followed by a clear byline.
    byline = re.search(
        r"\bBy\s+[A-Z][A-Za-z.'’\-]+"
        r"(?:\s+[A-Z][A-Za-z.'’\-]+){0,5}\s+"
        r"(?=(?:Sri Lanka|The|World Bank|Market|Fitch|Pan Asia|"
        r"Exceeding|Amidst|Yesterday|CSE|Secondary|Investors|"
        r"Conventional)\b)",
        compact[:650],
        flags=re.I,
    )

    if byline:
        compact = compact[byline.end():].strip()

    compact = re.sub(r"\s+", " ", compact).strip()

    # Drop a visibly clipped lower-case opening fragment.
    if compact and compact[0].islower():
        boundary = re.search(r"[.!?]\s+", compact)
        if boundary and boundary.end() <= 260:
            remainder = compact[boundary.end():].strip()
            if remainder and remainder[0].isupper():
                compact = remainder

    return compact


def _protect_sentence_abbreviations(text: str) -> tuple[str, dict[str, str]]:
    abbreviations = (
        "Rs.",
        "Mr.",
        "Mrs.",
        "Ms.",
        "Dr.",
        "Prof.",
        "No.",
        "Nos.",
        "St.",
        "Ltd.",
        "Inc.",
        "PLC.",
        "a.m.",
        "p.m.",
        "e.g.",
        "i.e.",
    )

    protected = text
    mapping: dict[str, str] = {}

    for index, abbreviation in enumerate(abbreviations):
        token = f"__ABBR_{index}__"
        if abbreviation in protected:
            protected = protected.replace(abbreviation, token)
            mapping[token] = abbreviation

    return protected, mapping


def _restore_sentence_abbreviations(text: str, mapping: dict[str, str]) -> str:
    for token, abbreviation in mapping.items():
        text = text.replace(token, abbreviation)
    return text


def source_summary(
    text: str,
    *,
    max_characters: int = 950,
    max_sentences: int = 5,
) -> str:
    """
    Deterministic source-derived summary with no invented facts.

    Uses complete source sentences after cleaning common publisher
    teaser, byline, escaped-newline and abbreviation artefacts.
    """
    text = _clean_raw_source_text(text)

    if not text:
        return ""

    protected, abbreviations = _protect_sentence_abbreviations(text)

    sentences = [
        _restore_sentence_abbreviations(part.strip(), abbreviations)
        for part in re.split(r"(?<=[.!?])\s+", protected)
        if part.strip()
    ] or [text]

    selected: list[str] = []
    total = 0

    for sentence in sentences:
        if len(selected) >= max_sentences:
            break

        addition = len(sentence) + (1 if selected else 0)

        if selected and total + addition > max_characters:
            break

        if not selected and len(sentence) > max_characters:
            clipped = sentence[:max_characters]
            cut = clipped.rfind(" ")
            if cut > int(max_characters * 0.65):
                clipped = clipped[:cut]
            return clipped.rstrip(" ,;:-") + "…"

        selected.append(sentence)
        total += addition

        if len(selected) >= 3 and total >= int(max_characters * 0.72):
            break

    summary = " ".join(selected).strip()

    if len(summary) > max_characters:
        summary = summary[:max_characters]
        cut = summary.rfind(" ")
        if cut > int(max_characters * 0.65):
            summary = summary[:cut]
        summary = summary.rstrip(" ,;:-") + "…"

    return safe_text(summary)


def first_sentences(text: str, *, max_characters: int) -> str:
    return source_summary(text, max_characters=max_characters, max_sentences=5)


def primary_entities(analysis: dict) -> list[str]:
    roles = ((analysis.get("ml", {}) or {}).get("entity_roles", {}) or {})
    return [
        safe_text(value)
        for value in (roles.get("primary_entities", []) or [])
        if safe_text(value)
    ]


def all_entities(analysis: dict) -> list[str]:
    ml = analysis.get("ml", {}) or {}
    roles = ml.get("entity_roles", {}) or {}
    values = [
        safe_text(item.get("canonical_name"))
        for item in (roles.get("entities", []) or [])
        if safe_text(item.get("canonical_name"))
    ]
    if values:
        return values
    return [
        safe_text(item.get("canonical_name"))
        for item in (ml.get("cbsl_entity_matches", []) or [])
        if safe_text(item.get("canonical_name"))
    ]


def primary_entity_details(analysis: dict) -> list[dict]:
    ml = analysis.get("ml", {}) or {}
    roles = ml.get("entity_roles", {}) or {}
    primary = {
        safe_text(value)
        for value in (roles.get("primary_entities", []) or [])
        if safe_text(value)
    }
    if not primary:
        return []

    details = []
    for item in (roles.get("entities", []) or []):
        name = safe_text(item.get("canonical_name"))
        if name and name in primary:
            details.append(
                {
                    "canonical_name": name,
                    "institution_type": safe_text(item.get("institution_type")),
                }
            )

    known = {item["canonical_name"] for item in details}
    for name in sorted(primary):
        if name not in known:
            details.append({"canonical_name": name, "institution_type": ""})
    return details


def has_primary_regulated_entity(analysis: dict) -> bool:
    regulated_types = {
        "LICENSED_COMMERCIAL_BANK",
        "LICENSED_SPECIALISED_BANK",
        "LICENSED_FINANCE_COMPANY",
        "SPECIALISED_LEASING_COMPANY",
        "REGULATOR",
        "REGULATOR_UNIT",
    }
    return any(
        safe_text(item.get("institution_type")) in regulated_types
        for item in primary_entity_details(analysis)
    )


def display_topic(topic: str, config: dict) -> str:
    names = config.get("topic_display_names", {}) or {}
    return safe_text(names.get(topic, topic.replace("_", " ").title()))


def display_institution_type(value: str, config: dict) -> str:
    mapping = config.get("institution_type_display_names", {}) or {}
    value = safe_text(value)
    if not value:
        return ""
    return safe_text(mapping.get(value, value.replace("_", " ").title()))


def supervisory_lens(topics: Iterable[str], config: dict) -> str:
    mapping = config.get("supervisory_lens", {}) or {}
    values = []
    for topic in topics:
        text = safe_text(mapping.get(topic))
        if text and text not in values:
            values.append(text)
    return " ".join(values)


def calculate_supervisory_importance(
    *,
    topics: list[str],
    has_primary_regulated: bool,
    config: dict,
) -> tuple[float, tuple[str, ...]]:
    importance = config.get("importance", {}) or {}
    topic_weights = importance.get("topic_weights", {}) or {}
    components: list[str] = []

    if topics:
        strongest = max(topics, key=lambda topic: float(topic_weights.get(topic, 0)))
        base = float(topic_weights.get(strongest, 0))
        components.append(f"TOPIC:{strongest}:{base:g}")
    else:
        base = 0.0

    score = base
    if has_primary_regulated:
        value = float(importance.get("primary_regulated_entity_bonus", 15))
        score += value
        components.append(f"PRIMARY_REGULATED_ENTITY:{value:g}")
    return float(score), tuple(components)


def calculate_display_priority(
    *,
    topics: list[str],
    has_primary_regulated: bool,
    stage_b_label: str = "",
    event_group_count: int = 0,
    related_story_count: int = 0,
    hdbscan_outlier: bool = False,
    config: dict,
) -> tuple[float, tuple[str, ...]]:
    return calculate_supervisory_importance(
        topics=topics,
        has_primary_regulated=has_primary_regulated,
        config=config,
    )


@dataclass(frozen=True)
class DigestArticle:
    publication_date: str
    source_name: str
    headline: str
    source_url: str
    news_summary: str
    primary_topic: str
    topic_labels: tuple[str, ...]
    topic_display_names: tuple[str, ...]
    supervisory_lens: str
    primary_entities: tuple[str, ...]
    primary_entity_types: tuple[str, ...]
    all_entities: tuple[str, ...]
    has_primary_regulated_entity: bool
    stage_b_label: str
    stage_b_confidence: float | None
    hdbscan_cluster: int | None
    hdbscan_outlier: bool
    related_story_count: int
    event_group_ids: tuple[str, ...]
    phase2_review_priority: str
    stage1_stage_a_status: str
    supervisory_importance_score: float
    supervisory_importance_components: tuple[str, ...]

    def to_dict(self) -> dict:
        payload = asdict(self)
        payload["excerpt"] = self.news_summary
        payload["display_priority_score"] = self.supervisory_importance_score
        payload["display_priority_components"] = self.supervisory_importance_components
        return payload


def render_html(
    *,
    title: str,
    period_label: str,
    generated_at: str,
    metrics: dict,
    priority_articles: list[DigestArticle],
    macro_market_articles: list[DigestArticle],
    other_articles: list[DigestArticle],
    review_rows: list[dict],
    event_groups: list[dict],
    config: dict,
) -> str:
    """
    Render one stakeholder-facing, self-contained HTML report.

    This browser presentation template is designed to work as:
      - the normal daily report,
      - a standalone browser file,
      - an email attachment,
      - a printable / Save-as-PDF document.

    No external CSS, fonts, JavaScript or images are required.
    Technical QA fields remain in JSON/CSV audit outputs and are not shown
    in the stakeholder report.
    """

    def topic_badges(article: DigestArticle) -> str:
        return "".join(
            f'<span class="topic-chip">{escape(name)}</span>'
            for name in article.topic_display_names
        )

    def entity_text(article: DigestArticle) -> tuple[str, str]:
        if article.primary_entities:
            name = " · ".join(article.primary_entities)
            type_text = " · ".join(
                value
                for value in article.primary_entity_types
                if value
            )
            return name, type_text
        return "Across the financial sector", ""

    def source_link(article: DigestArticle, label: str = "View original source") -> str:
        return (
            f'<a class="source-link" '
            f'href="{escape(article.source_url, quote=True)}" '
            f'target="_blank" rel="noopener noreferrer">'
            f'{escape(label)} ↗</a>'
        )

    def priority_card(article: DigestArticle, number: int) -> str:
        entity_name, entity_type = entity_text(article)

        return f"""
        <article class="priority-card">
            <div class="priority-number">{number:02d}</div>
            <div class="priority-body">
                <div class="story-topline">
                    <span>{escape(article.source_name)}</span>
                    <span class="dot">•</span>
                    <span>{escape(article.publication_date)}</span>
                </div>

                <h3>{escape(article.headline)}</h3>

                <div class="meta-row">
                    <div class="meta-main">
                        <div class="meta-label">Who it affects</div>
                        <div class="entity-name">{escape(entity_name)}</div>
                        {f'<div class="entity-type">{escape(entity_type)}</div>' if entity_type else ''}
                    </div>
                    <div class="meta-topics">{topic_badges(article)}</div>
                </div>

                <div class="summary-block">
                    <div class="block-label">What happened</div>
                    <p>{escape(article.news_summary)}</p>
                </div>

                <div class="relevance-block">
                    <div class="block-label">Why it matters</div>
                    <p>{escape(article.supervisory_lens)}</p>
                </div>

                <div class="story-footer">
                    {source_link(article)}
                </div>
            </div>
        </article>
        """

    def context_card(article: DigestArticle) -> str:
        entity_name, entity_type = entity_text(article)
        return f"""
        <article class="context-card">
            <div class="context-card-head">
                <div>
                    <div class="story-topline">
                        <span>{escape(article.source_name)}</span>
                        <span class="dot">•</span>
                        <span>{escape(article.publication_date)}</span>
                    </div>
                    <h3>{escape(article.headline)}</h3>
                </div>
                {source_link(article, "Source")}
            </div>

            <div class="compact-meta">
                <span class="scope-text"><strong>{escape(entity_name)}</strong>{f' · {escape(entity_type)}' if entity_type else ''}</span>
                <span class="topic-wrap">{topic_badges(article)}</span>
            </div>

            <p class="context-summary">{escape(article.news_summary)}</p>

            <div class="context-bottom">
                <div class="context-relevance"><strong>Why it matters:</strong> {escape(article.supervisory_lens)}</div>
            </div>
        </article>
        """

    def event_section() -> str:
        if not event_groups:
            return ""

        blocks = []
        for group in event_groups:
            members = group.get("members", []) or []
            member_rows = "".join(
                f"<li><strong>{escape(safe_text(item.get('headline')))}</strong>"
                f"<span>{escape(safe_text(item.get('source_name')))}</span></li>"
                for item in members
            )
            blocks.append(
                f"""
                <div class="event-group">
                    <div class="event-label">Related coverage</div>
                    <ul>{member_rows}</ul>
                </div>
                """
            )

        return f"""
        <section class="report-section">
            <div class="section-title-row">
                <div>
                    <div class="section-kicker">CONTINUING COVERAGE</div>
                    <h2>Continuing stories</h2>
                </div>
            </div>
            {''.join(blocks)}
        </section>
        """

    priority_html = (
        "".join(
            priority_card(article, index)
            for index, article in enumerate(priority_articles, start=1)
        )
        if priority_articles
        else '<div class="empty-state">No key developments for this period.</div>'
    )

    macro_html = (
        "".join(context_card(article) for article in macro_market_articles)
        if macro_market_articles
        else '<div class="empty-state">No economy or market updates for this period.</div>'
    )

    other_html = ""
    if other_articles:
        rows = "".join(context_card(article) for article in other_articles)
        other_html = f"""
        <section class="report-section secondary-section">
            <div class="section-title-row">
                <div>
                    <div class="section-kicker">MORE NEWS</div>
                    <h2>Other news</h2>
                    <p>Additional news from across the financial sector.</p>
                </div>
            </div>
            {rows}
        </section>
        """

    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{escape(title)} | News Brief</title>
<style>
* {{
    box-sizing: border-box;
}}
html {{
    background: #edf1f5;
}}
body {{
    margin: 0;
    background: #edf1f5;
    color: #1b2733;
    font-family: "Segoe UI", Arial, Helvetica, sans-serif;
    font-size: 16px;
    line-height: 1.58;
}}
a {{
    color: #0d547a;
}}
.report-shell {{
    width: 100%;
    max-width: 1080px;
    margin: 28px auto;
    background: #ffffff;
    border: 1px solid #dce3e9;
    box-shadow: 0 12px 34px rgba(22, 41, 58, 0.08);
}}
.top-rule {{
    height: 6px;
    background: #0b3154;
}}
a:focus-visible {{ outline:3px solid #b28a44; outline-offset:3px; }}
.report-header {{
    padding: 30px 38px 24px;
    border-bottom: 1px solid #dce3e9;
}}
.header-kicker {{
    margin-bottom: 8px;
    color: #577080;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
}}
.header-row {{
    display: table;
    width: 100%;
}}
.header-title,
.header-date {{
    display: table-cell;
    vertical-align: bottom;
}}
.header-title h1 {{
    margin: 0;
    color: #0b3154;
    font-size: 38px;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.4px;
}}
.header-title p {{
    margin: 7px 0 0;
    color: #617381;
    font-size: 16px;
}}
.header-date {{
    width: 230px;
    text-align: right;
}}
.date-label {{
    color: #70828f;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}}
.date-value {{
    margin-top: 4px;
    color: #0b3154;
    font-size: 18px;
    font-weight: 700;
}}

.report-content {{
    padding: 8px 38px 32px;
}}
.report-section {{
    margin-top: 32px;
}}
.section-title-row {{
    display: table;
    width: 100%;
    margin-bottom: 14px;
}}
.section-title-row > div {{
    display: table-cell;
    vertical-align: bottom;
}}
.section-title-row h2 {{
    margin: 1px 0 0;
    color: #173a56;
